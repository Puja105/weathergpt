# Neon PostgreSQL connection string. Include sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# OpenRouter is used for chatbot completions and embeddings.
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openrouter/free
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b:free

# Optional: cosine similarity cutoff for RAG results (0 to 1).
RAG_MIN_SIMILARITY=0.25

# Comma-separated frontend origins. Add your deployed frontend URL here.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
