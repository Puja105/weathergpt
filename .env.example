# Neon PostgreSQL connection string (Neon Dashboard -> Project -> Connection Details).
# Use the pooled connection string if your application opens frequent short-lived connections.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# OpenAI API key (needed for chat, intent extraction, and embeddings).
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Comma-separated browser origins. Add your deployed frontend URL before deployment.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
